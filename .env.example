DATABASE_URL=postgresql://pumamap:CHANGE_ME@127.0.0.1:5432/pumamap
APP_ORIGIN=http://localhost:3000
# production: smtp. file is restricted to development and writes private local mail.
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional development-only bundler diagnostic; leave unset for normal Next development.
# PUMAMAP_DEV_WEBPACK=1
# Media is transactional PostgreSQL bytea in 0.4; no public uploads path or S3 secret needed.
